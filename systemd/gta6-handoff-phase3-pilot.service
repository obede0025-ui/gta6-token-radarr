[Unit]
Description=GTA6 isolated phase-3 B3-to-M1 event-driven research pilot (no trades)
After=gta6-minute-market-pilot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/gta6-v32-gate-pilot
ExecStart=/home/ubuntu/gta6-source/.venv/bin/python /home/ubuntu/gta6-v32-gate-pilot/research_minute_handoff_phase3.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/gta6-v32-gate-pilot/handoff_phase3_pilot
PrivateTmp=true
