[Unit]
Description=GTA6 isolated M1 minute research follow-up (no trades)
After=gta6-b3-minute-safety-shadow.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/gta6-v32-gate-pilot
ExecStart=/home/ubuntu/gta6-source/.venv/bin/python /home/ubuntu/gta6-v32-gate-pilot/research_m1_minute_followup.py
# Ignore quote API errors so M1 research stays healthy. This GET-only
# quote observer maintains its own isolated state.
ExecStartPost=-/home/ubuntu/gta6-source/.venv/bin/python /home/ubuntu/gta6-v32-gate-pilot/research_jupiter_minute_quotes.py
NoNewPrivileges=true
